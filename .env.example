# Safe first run: make one request and never place orders.
BOR_MODE=live_once
BOR_RELEASE_DATE=24.07.2026
BOR_RELEASE_TIME_SUFFIX=133000key_e
BOR_POLL_SLEEP_SEC=0.25
BOR_HEARTBEAT_SEC=10
BOR_CONNECT_TIMEOUT_SEC=0.5
BOR_READ_TIMEOUT_SEC=0.5
BOR_PREFIX_MAX_BYTES=32768
BOR_PREFIX_CHUNK_SIZE=2048
BOR_DISABLE_CACHE_BUSTER=0

LOG_LEVEL=INFO
CBR_DRY_RUN=1
# Required to calculate the change in basis points and evaluate rules.
BOR_PREV_RATE=

# Database routing. CBR_ON_RENDER overrides the legacy SERVER flag.
# Render private network: CBR_ON_RENDER=1 -> server_int.
# Northflank, local machine, or VPS: CBR_ON_RENDER=0 -> server_ext.
CBR_ON_RENDER=0
PRIMARY_DB_TARGET=
ANALYTICS_DB_TARGET=
DATABASE_URL_LOCAL=
DATABASE_URL_SERVER_INT=
DATABASE_URL_SERVER_EXT=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=codexpoly
DATABASE_USER=codexpoly_app
DATABASE_APP_PASSWORD=
POSTGRES_USER=codexpoly_admin
POSTGRES_PASSWORD=
ANALYTICS_DATABASE_URL_LOCAL=
ANALYTICS_DATABASE_URL_SERVER_INT=
ANALYTICS_DATABASE_URL_SERVER_EXT=

# Optional direct URL overrides for each role.
CBR_DATABASE_URL=
CBR_ANALYTICS_DATABASE_URL=

# Optional read-only preload of active CBR rules from the primary DB.
CBR_RULES_DB_ENABLED=0

# Live runner safety. Keep disabled until the warmed preflight has been
# checked and the exact automatic orders have been explicitly approved.
CBR_LIVE_TRADING_ENABLED=0
CBR_LIVE_ALLOWED_ACCOUNT=
CBR_LIVE_MAX_ORDER_QTY=
CBR_LIVE_MAX_NOTIONAL=
# Aggregate maximum across all orders one release can trigger.
CBR_LIVE_MAX_TOTAL_NOTIONAL=
# 0 = ordinary GTC limit: take asks up to the limit and rest the remainder.
# 1 = maker-only GTC: skip when the configured BUY would cross the ask.
CBR_LIVE_POST_ONLY=0
# Fernet key already used to encrypt trading_accounts.pk_enc.
ACCOUNTS_MASTER_KEY=
# Account source: database keeps legacy behavior. single_secret loads one
# account from non-secret metadata plus the encrypted file-secret below.
TRADING_ACCOUNT_SOURCE=database
TRADING_ACCOUNT_NAME=
TRADING_ACCOUNT_WALLET_ADDRESS=
TRADING_ACCOUNT_VENUE=polymarket_clob
TRADING_ACCOUNT_SIGNATURE_TYPE=
TRADING_ACCOUNT_PRIVATE_KEY_ENCRYPTED=
# Legacy/manual multi-account fallback uses one shared ACCOUNTS_MASTER_KEY
# and a separate encrypted key named with an uppercase normalized suffix:
# kinderSman -> TRADING_ACCOUNT_PRIVATE_KEY_ENCRYPTED_KINDERSMAN
# sport-two  -> TRADING_ACCOUNT_PRIVATE_KEY_ENCRYPTED_SPORT_TWO

# Universal post-submission supervision. This never applies migrations.
# Keep disabled until migrations 001 and 002 have been applied explicitly.
RESOLUTION_SUPERVISION_ENABLED=0
RESOLUTION_SUPERVISION_WATCH_REFRESH_SEC=2
RESOLUTION_SUPERVISION_RECONCILE_SEC=30
RESOLUTION_SUPERVISION_STALE_SEC=300
RESOLUTION_SUPERVISION_BATCH_SIZE=100

# Separate write access used only by `python -m cbr_trading.admin --apply`.
# When empty, the selected primary URL above is used.
CBR_ADMIN_DATABASE_URL=
CBR_ACCOUNT_NAME_FAST=
CBR_ORDER_QTY=10
CBR_ORDER_PRICE_YES=0.99
CBR_ORDER_PRICE_NO=0.99
CBR_ORDER_PRICE_YES_INCREASE=
CBR_ORDER_PRICE_NO_INCREASE=
CBR_TG_CHAT_ID=
CBR_GAMMA_TIMEOUT_SEC=10

# Telegram is opt-in. Keep disabled until both values below are configured.
CBR_TELEGRAM_ENABLED=0
TG_BOT_TOKEN=
TELEGRAM_INGEST_CHAT_ID=
TG_HTTP_TIMEOUT=10

# Source-neutral notification outbox. Telegram delivery runs in a separate
# worker and never blocks source parsing or order execution.
NEWS_TELEGRAM_TIMEOUT_SEC=10
NEWS_NOTIFICATION_DELIVERY_DELAY_SEC=2
NEWS_NOTIFICATION_POLL_SEC=0.5
NEWS_NOTIFICATION_RETRY_SEC=10
NEWS_NOTIFICATION_LEASE_SEC=30
NEWS_NOTIFICATION_HEARTBEAT_SEC=60

# Profile lifecycle. AUTO_PREFLIGHT never enables execution profiles.
PROFILE_SCHEDULER_POLL_SEC=2
PROFILE_SCHEDULER_HEARTBEAT_SEC=60
PROFILE_SCHEDULER_ACTIVATION_GRACE_SEC=60
PROFILE_SCHEDULER_BATCH_SIZE=100
PROFILE_SCHEDULER_AUTO_LIVE_ENABLED=0
PROFILE_SCHEDULER_MAX_TOTAL_NOTIONAL=

# Non-submitting authenticated readiness worker. It runs only through the
# trading overlay, so the scheduler itself never receives trading secrets.
PROFILE_READINESS_POLL_SEC=1
PROFILE_READINESS_HEARTBEAT_SEC=60
PROFILE_READINESS_LEASE_SEC=60
PROFILE_READINESS_RETRY_SEC=10
PROFILE_READINESS_TTL_SEC=1800

# SEC WebSocket remains connected continuously. Public IR and press-wire
# polling is additionally gated by an enabled in-window earnings profile.
EARNINGS_WORKER_MODE=shadow
EARNINGS_HTTP_USER_AGENT=
EARNINGS_FETCH_TIMEOUT_SEC=15
EARNINGS_MAX_DOCUMENT_BYTES=8388608
EARNINGS_FETCH_ATTEMPTS=3
EARNINGS_FETCH_RETRY_SEC=0.5
EARNINGS_RECONNECT_INITIAL_SEC=1
EARNINGS_RECONNECT_MAX_SEC=30
EARNINGS_NO_RULES_RETRY_SEC=30
EARNINGS_HEARTBEAT_SEC=60
EARNINGS_PUBLIC_SOURCES_ENABLED=0
EARNINGS_PUBLIC_POLL_SEC=1
EARNINGS_SEC_CURRENT_POLL_ENABLED=0
EARNINGS_SEC_CURRENT_POLL_SEC=0.25
EARNINGS_SEC_CURRENT_MAX_REQUESTS_PER_SEC=5
EARNINGS_SEC_LATEST_POLL_ENABLED=0
EARNINGS_SEC_LATEST_POLL_SEC=0.25
EARNINGS_SEC_LATEST_MAX_REQUESTS_PER_SEC=5
EARNINGS_SOURCE_OBSERVATION_TAIL_SEC=900
SEC_API_KEY=
MSTR_BTC_SHADOW_ENABLED=0
MSTR_BTC_LEDGER_ENABLED=0
MSTR_BTC_LEDGER_URL=https://www.strategy.com/ledger
MSTR_BTC_LEDGER_POLL_SEC=2
MSTR_BTC_LEDGER_TIMEOUT_SEC=10
